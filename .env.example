# Copiá este archivo a .env y completá los valores. .env NO se versiona.

# Django
DJANGO_SECRET_KEY=generá-una-con-get_random_secret_key
DJANGO_DEBUG=1
MLS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Base de datos (PostgreSQL + PostGIS)
MLS_DB_NAME=mls_db
MLS_DB_USER=mls_user
MLS_DB_PASSWORD=cambiá-esto
MLS_DB_HOST=localhost
MLS_DB_PORT=5432

# BunnyCDN (opcional: sin estas variables se guarda en MEDIA_ROOT)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_PULL_ZONE=
BUNNY_REGION=
